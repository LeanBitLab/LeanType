<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
        Custom AI endpoints are entered by the user at runtime (Ollama, LM Studio, self-hosted servers,
        self-signed or private-CA certificates), so the base config has to stay open for them. Plain HTTP
        is still blocked in the app unless "Allow insecure connections" is enabled.
    -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!--
        Hosts the app contacts by itself (AI providers, model and plugin downloads, updates) are fixed, so
        they only get HTTPS with the system CAs. A user-installed CA cannot intercept API keys or downloads.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">groq.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">hf.co</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">codeberg.org</domain>
        <domain includeSubdomains="true">google.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- debug builds can still be inspected with a proxy -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
