    <string name="auto_correct_aggressiveness_4">बहुत आक्रामक</string>
    <string name="auto_correct_aggressiveness_desc_1">मामूली\nमानक फ़ील्ड्स में केवल बहुत करीबी वर्तनी वाले शब्दों को ठीक करता है।</string>
    <string name="auto_correct_aggressiveness_desc_2">संतुलित (डिफ़ॉल्ट)\nसमर्थित इनपुट फ़ील्ड्स में मानक सुधार विश्वसनीयता।</string>
    <string name="auto_correct_aggressiveness_desc_3">आक्रामक\nस्वतः सुधार को अधिक ऐप्स और गैर-सहायता प्राप्त फ़ील्ड्स तक बढ़ाता है।</string>
    <string name="auto_correct_aggressiveness_desc_4">बहुत आक्रामक\nसभी फ़ील्ड्स में किसी भी करीबी मिलान के लिए बिना शर्त सुधार।</string>
    <string name="fine_tune_autocorrect_title">स्वतः सुधार को फाइन-ट्यून करें</string>
    <string name="fine_tune_autocorrect_summary">ट्रिगर्स, अतिरिक्त स्थितियां और शॉर्टकट विस्तार कॉन्फ़िगर करें</string>
    <string name="fine_tune_prediction_title">अनुमान को फाइन-ट्यून करें</string>
    <string name="fine_tune_prediction_summary">व्यक्तिगत शब्द प्राथमिकता, संदर्भ और वाक्य की शुरुआत को मैन्युअल रूप से समायोजित करें</string>
    <string name="suggestion_balance_title">सुझाव संतुलन</string>
    <string name="suggestion_balance_summary">शब्दकोश सटीकता और व्यक्तिगत टाइपिंग इतिहास के बीच संतुलन समायोजित करें</string>
    <string name="suggestion_balance_1">शब्दकोश-केंद्रित</string>
    <string name="suggestion_balance_2">रूढ़िवादी</string>
    <string name="suggestion_balance_3">संतुलित (डिफ़ॉल्ट)</string>
